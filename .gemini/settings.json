{
  "tools": {
    "requireConfirmation": true,
    "autoApprove": false,
    "allowed": [
      "*",
      "run_shell_command",
      "write_file",
      "replace",
      "mcp_filesystem_read_file",
      "mcp_filesystem_write_file",
      "mcp_filesystem_edit_file",
      "mcp_filesystem_create_directory",
      "mcp_filesystem_move_file",
      "mcp_shell_run_command",
      "mcp_mysql_execute_query",
      "google_web_search",
      "web_fetch",
      "Skill(figma:figma-use-figjam)",
      "Skill(figma:figma-use)",
      "Skill(figma:figma-generate-design)",
      "Skill(figma:figma-generate-library)",
      "Skill(figma:figma-generate-diagram)",
      "Skill(figma:figma-code-connect)",
      "Skill(figma:figma-create-design-system-rules)",
      "Skill(figma:figma-implement-design)",
      "activate_skill",
      "Skill(last30days)",
      "Skill(using-superpowers)",
      "Skill(brainstorming)",
      "Skill(writing-plans)",
      "Skill(executing-plans)",
      "Skill(dispatching-parallel-agents)",
      "Skill(subagent-driven-development)",
      "Skill(verification-before-completion)",
      "Skill(test-driven-development)",
      "Skill(systematic-debugging)",
      "Skill(requesting-code-review)",
      "Skill(receiving-code-review)",
      "Skill(finishing-a-development-branch)",
      "Skill(using-git-worktrees)"
    ],
    "allowedCommands": [
      "npm *",
      "npx *"
    ]
  },
  "allowedCommands": [
    "npm *",
    "npx *"
  ],
  "antigravity.agent.terminal.allowedCommands": [
    "npm *",
    "npx *"
  ],
  "antigravity.agent.terminal.confirmCommands": false,
  "antigravity.agent.terminal.autoExecutionPolicy": "always",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /c \"start cmd.exe /c scripts\\start-be.bat & start cmd.exe /c scripts\\start-fe.bat\"",
            "timeout": 30,
            "statusMessage": "启动 Navatation 核心服务",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /c \"scripts\\stop-be.bat & scripts\\stop-fe.bat\"",
            "timeout": 15,
            "statusMessage": "正在关闭 Navatation 核心服务",
            "async": true
          }
        ]
      }
    ]
  }
}
