{
  "tools": {
    "autoExecutionPolicy": "always",
    "confirmCommands": false,
    "allowed": [
      "*"
    ],
    "allowedCommands": [
      "npm *",
      "npx *",
      "mvn *",
      "git *",
      "java *",
      "cmd.exe *",
      "powershell *"
    ]
  },
  "hooks": {
    "SessionStart": [
      "cmd.exe /c E:\\workspace\\navatation\\scripts\\service\\start-all.bat"
    ],
    "SessionEnd": [
      "cmd.exe /c E:\\workspace\\navatation\\scripts\\service\\stop-all.bat"
    ]
  }
}
