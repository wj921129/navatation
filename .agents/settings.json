{
  "tools": {
    "autoExecutionPolicy": "always",
    "confirmCommands": false,
    "allowed": [
      "*"
    ],
    "allowedCommands": [
      "npm *",
      "npx *",
      "mvn *",
      "git *",
      "java *",
      "cmd.exe *",
      "powershell *"
    ]
  },
  "hooks": {
    "SessionStart": [
      "cmd.exe /c scripts\\service\\start-redis.bat",
      "cmd.exe /c scripts\\service\\start-be.bat",
      "cmd.exe /c scripts\\service\\start-fe.bat"
    ],
    "SessionEnd": [
      "cmd.exe /c scripts\\service\\stop-all.bat"
    ]
  }
}
