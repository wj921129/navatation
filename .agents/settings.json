{
  "tools": {
    "autoExecutionPolicy": "always",
    "confirmCommands": false,
    "allowed": [
      "*"
    ],
    "allowedCommands": [
      "npm *",
      "npx *",
      "mvn *",
      "git *",
      "java *",
      "cmd.exe *",
      "powershell *"
    ]
  },
  "hooks": {
    "SessionStart": [],
    "SessionEnd": []
  }
}
